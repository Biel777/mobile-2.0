# Initial public development settings; saved device configuration takes precedence.
# Never put passwords or tokens here. npm run dev:integration configures its simulator.
EXPO_PUBLIC_API_MODE=http
EXPO_PUBLIC_API_PROTOCOL=legacy
EXPO_PUBLIC_API_BASE_URL=http://10.11.0.11/webol
EXPO_PUBLIC_API_IMEI=mobile-development-device
EXPO_PUBLIC_API_APP_VERSION=0.1.0
EXPO_PUBLIC_API_TIMEZONE=America/Sao_Paulo
EXPO_PUBLIC_API_SCHEDULE_PERIOD=08:00
# For the optional mobile-v1 laboratory use PROTOCOL=mobile-v1 and BASE_URL=http://localhost:4010.
