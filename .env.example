# Public build-time settings. Never put passwords, tokens or secrets here.
# npm run dev:integration supplies local simulator settings automatically.
EXPO_PUBLIC_API_MODE=http
EXPO_PUBLIC_API_PROTOCOL=legacy
EXPO_PUBLIC_API_BASE_URL=http://localhost:4010
EXPO_PUBLIC_API_IMEI=mobile-development-device
EXPO_PUBLIC_API_APP_VERSION=0.1.0
EXPO_PUBLIC_API_TIMEZONE=America/Sao_Paulo
EXPO_PUBLIC_API_SCHEDULE_PERIOD=08:00
# Only if the tenant login does not return id_usuario: use the validated user ID.
# id_nivel is NOT the representative's user ID.
# EXPO_PUBLIC_API_USER_ID=77

# For mobile-v1 laboratory, set PROTOCOL=mobile-v1. API_URL is a BASE_URL alias.
# On a phone/emulator use the reachable host IP instead of localhost.
