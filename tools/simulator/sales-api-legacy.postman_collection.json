{
  "info": {
    "name": "Sales API Legacy — laboratório Força de Vendas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rotas/formulários conforme mapa fornecido. Envelopes de leitura e códigos CF são sintéticos; homologar com respostas do tenant. Somente dados fictícios por padrão. Sem garantias de deduplicação em backend real; não reenviar sem conferir."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4010",
      "type": "string"
    },
    {
      "key": "login",
      "value": "marina",
      "type": "string"
    },
    {
      "key": "password",
      "value": "demo",
      "type": "string"
    },
    {
      "key": "imei",
      "value": "postman-development",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "syncCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "billingCode",
      "value": "CF-501-21",
      "type": "string"
    },
    {
      "key": "orderClientId",
      "value": "postman-demo-001",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "9000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login fictício Legacy",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{baseUrl}}/index.php?r=api/authentication/new",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "user[login]",
              "value": "{{login}}",
              "type": "text"
            },
            {
              "key": "user[senha]",
              "value": "{{password}}",
              "type": "text"
            },
            {
              "key": "user[imei]",
              "value": "{{imei}}",
              "type": "text"
            },
            {
              "key": "user[versao]",
              "value": "0.1.0",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.status === \"ok\") { pm.collectionVariables.set(\"token\", data.token); pm.collectionVariables.set(\"syncCode\", String(data.codigo_sincronizacao)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Renovar sync",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{baseUrl}}/index.php?r=api/session/new",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "user[login]",
              "value": "{{login}}",
              "type": "text"
            },
            {
              "key": "user[token]",
              "value": "{{token}}",
              "type": "text"
            },
            {
              "key": "user[codigo_sincronizacao]",
              "value": "{{syncCode}}",
              "type": "text"
            },
            {
              "key": "user[versao]",
              "value": "0.1.0",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.codigo_sincronizacao) pm.collectionVariables.set(\"syncCode\", String(data.codigo_sincronizacao));"
            ]
          }
        }
      ]
    },
    {
