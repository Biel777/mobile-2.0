{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@bff/*": [
        "./src/bff/*"
      ],
      "@rules/*": [
        "./src/bff/rules/*"
      ],
      "@tradetools/*": [
        "./src/bff/tradetools/*"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
